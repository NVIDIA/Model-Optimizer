{
  "quant_cfg": [
    {
      "quantizer_name": "*",
      "enable": false
    },
    {
      "quantizer_name": "*linear_attn_sites.*",
      "cfg": {
        "num_bits": [
          4,
          3
        ],
        "type": "dynamic",
        "axis": [
          0,
          1,
          2
        ]
      }
    },
    {
      "quantizer_name": "*kda_w_quantizer",
      "cfg": {
        "num_bits": [
          4,
          3
        ],
        "type": "dynamic",
        "axis": [
          0,
          1,
          2
        ]
      }
    }
  ],
  "algorithm": null,
  "linear_attention": [
    {
      "module_name": "model.layers.*.self_attn",
      "cfg": {
        "backend": "matmul",
        "solve": {
          "method": "neumann",
          "degree": 3,
          "implementation": "triton"
        }
      }
    }
  ]
}
